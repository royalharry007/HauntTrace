{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HauntTrace",
  "version": "0.1.0",
  "identifier": "dev.haunttrace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "HauntTrace",
        "width": 520,
        "height": 760,
        "minWidth": 420,
        "minHeight": 600,
        "backgroundColor": "#100d15"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "Local AI ghost detective for lingering process activity",
    "longDescription": "HauntTrace spots lingering or unusual process activity with deterministic rules, alerts you, and investigates the evidence with a locally running Gemma model.",
    "externalBin": [
      "binaries/haunt-burner"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "publisher": "HauntTrace contributors",
    "copyright": "MIT License"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "haunttrace"
        ]
      }
    }
  }
}